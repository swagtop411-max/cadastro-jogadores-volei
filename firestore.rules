rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'swagtop411@gmail.com';
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.papel == 'usuario';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.papel == resource.data.papel;
      allow delete: if isAdmin();
    }

    match /perfis/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100;
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    match /atletas/{atletaId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome','nascimento','cidade','uf','modalidades','posicoes','modalidade','posicao',
            'categoria','time','historicoEquipes','historicoCampeonatos','observacoes','foto',
            'ownerUid','ownerEmail','ownerDisplayName','atualizadoEm'
          ]));
    }

    match /atletas/{atletaId}/privado/{documento} {
      allow read, write: if isAdmin();
    }

    match /apoiadores/{apoiadorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comentarios/{comentarioId} {
      allow read: if isAdmin() || resource.data.aprovado == true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.keys().hasAll(['ownerUid','ownerEmail','atletaId','nome','texto','aprovado','status','criadoEm'])
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','atletaId','nome','texto','aprovado','status','criadoEm'])
        && request.resource.data.atletaId is string
        && request.resource.data.nome is string
        && request.resource.data.texto is string
        && request.resource.data.aprovado == false
        && request.resource.data.status == 'pendente'
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 80
        && request.resource.data.texto.size() >= 3
        && request.resource.data.texto.size() <= 500
        && request.resource.data.criadoEm is timestamp
        && exists(/databases/$(database)/documents/atletas/$(request.resource.data.atletaId));
      allow update, delete: if isAdmin();
    }

    match /campeonatos/{campeonatoId} {
      allow read: if isAdmin() || resource.data.publicado == true;
      allow create, update, delete: if isAdmin();
    }

    match /campeonatos_pendentes/{campeonatoId} {
      // Envio público: apenas cria uma solicitação pendente.
      allow create: if request.resource.data.keys().hasAll([
          'nome','organizador','data','local','descricao','imagem',
          'publicado','status','aprovacao','criadoEm'
        ])
        && request.resource.data.keys().hasOnly([
          'nome','organizador','data','local','descricao','imagem',
          'publicado','status','aprovacao','criadoEm'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.organizador is string
        && request.resource.data.organizador.size() >= 2
        && request.resource.data.organizador.size() <= 100
        && request.resource.data.data is string
        && request.resource.data.data.size() >= 8
        && request.resource.data.data.size() <= 20
        && request.resource.data.local is string
        && request.resource.data.local.size() >= 2
        && request.resource.data.local.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() <= 700
        && request.resource.data.imagem is string
        && request.resource.data.imagem.size() <= 850000
        && request.resource.data.publicado == false
        && request.resource.data.status == 'pendente'
        && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.criadoEm is string
        && request.resource.data.criadoEm.size() >= 10
        && request.resource.data.criadoEm.size() <= 40;

      allow read, update, delete: if isAdmin();
    }

    match /atletas_pendentes/{atletaId} {
      allow create: if (
          (request.auth != null
            && request.resource.data.ownerUid == request.auth.uid)
          ||
          (request.auth == null
            && request.resource.data.ownerUid == ''
            && request.resource.data.ownerEmail == '')
        )
        && request.resource.data.ownerEmail is string
        && request.resource.data.keys().hasAll(['nome','nascimento','cidade','uf','contato','categoria','time','foto','status','aprovacao','criadoEm','modalidades','posicoes','plano','planoId','valorPlano','planoStatus'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.nascimento is string
        && request.resource.data.cidade is string
        && request.resource.data.cidade.size() >= 2
        && request.resource.data.cidade.size() <= 80
        && request.resource.data.uf is string
        && request.resource.data.uf in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']
        && request.resource.data.contato is string
        && request.resource.data.contato.size() >= 8
        && request.resource.data.contato.size() <= 30
        && request.resource.data.modalidades is list
        && request.resource.data.modalidades.size() >= 1
        && request.resource.data.modalidades.size() <= 5
        && request.resource.data.posicoes is list
        && request.resource.data.posicoes.size() >= 1
        && request.resource.data.posicoes.size() <= 10
        && request.resource.data.modalidade is string
        && request.resource.data.posicao is string
        && request.resource.data.categoria is string
        && request.resource.data.categoria in ['Iniciante','Intermediário','Avançado']
        && request.resource.data.time is string
        && request.resource.data.time.size() >= 2
        && request.resource.data.time.size() <= 100
        && request.resource.data.observacoes is string
        && request.resource.data.observacoes.size() <= 500
        && request.resource.data.foto is string
        && request.resource.data.foto.size() <= 700000
        && request.resource.data.status == 'ativo'
        && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.get('historicoCampeonatos', []) is list
        && request.resource.data.get('historicoCampeonatos', []).size() <= 30
        && request.resource.data.plano in ['Gratuito','Bronze','Prata','Ouro','Premium']
        && request.resource.data.planoId in ['gratuito','bronze','prata','ouro','premium']
        && request.resource.data.valorPlano is number
        && ((request.resource.data.planoId == 'gratuito' && request.resource.data.valorPlano == 0)
          || (request.resource.data.planoId == 'bronze' && request.resource.data.valorPlano == 9.9)
          || (request.resource.data.planoId == 'prata' && request.resource.data.valorPlano == 19.9)
          || (request.resource.data.planoId == 'ouro' && request.resource.data.valorPlano == 34.9)
          || (request.resource.data.planoId == 'premium' && request.resource.data.valorPlano == 49.9))
        && request.resource.data.planoStatus in ['ativo','aguardando_pagamento']
        && request.resource.data.criadoEm is string
        && request.resource.data.get('pagamentoConfirmado', false) is bool;
      allow read: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome','nascimento','cidade','uf','contato','modalidades','posicoes','modalidade','posicao',
            'categoria','time','historicoCampeonatos','observacoes','foto'
          ]));
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    match /apoiadores_pendentes/{pedidoId} {
      allow create: if request.resource.data.keys().hasAll(['empresa','responsavel','contato','cidade','link','plano','planoId','valor','status','aprovacao','criadoEm'])
        && request.resource.data.keys().hasOnly(['empresa','responsavel','contato','cidade','link','imagem','plano','planoId','valor','status','aprovacao','criadoEm'])
        && request.resource.data.empresa is string
        && request.resource.data.empresa.size() >= 2
        && request.resource.data.empresa.size() <= 100
        && request.resource.data.responsavel is string
        && request.resource.data.responsavel.size() >= 2
        && request.resource.data.responsavel.size() <= 100
        && request.resource.data.contato is string
        && request.resource.data.contato.size() >= 5
        && request.resource.data.contato.size() <= 120
        && request.resource.data.cidade is string
        && request.resource.data.cidade.size() >= 2
        && request.resource.data.cidade.size() <= 80
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 300
        && (!request.resource.data.keys().hasAny(['imagem']) || (request.resource.data.imagem is string && request.resource.data.imagem.size() <= 700000))
        && request.resource.data.plano in ['Bronze','Prata','Ouro','Master']
        && request.resource.data.planoId in ['bronze','prata','ouro','master']
        && request.resource.data.valor is number
        && ((request.resource.data.plano == 'Bronze' && request.resource.data.planoId == 'bronze' && request.resource.data.valor == 50)
          || (request.resource.data.plano == 'Prata' && request.resource.data.planoId == 'prata' && request.resource.data.valor == 100)
          || (request.resource.data.plano == 'Ouro' && request.resource.data.planoId == 'ouro' && request.resource.data.valor == 200)
          || (request.resource.data.plano == 'Master' && request.resource.data.planoId == 'master' && request.resource.data.valor == 350))
        && request.resource.data.status == 'aguardando_pagamento'
        && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.criadoEm is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /equipes/{equipeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome','responsavel','uf','cidade','modalidade','categoria','contato','logo','atletas'
          ]));
    }

    match /equipes_pendentes/{equipeId} {
      allow create: if (
        (request.auth != null && request.resource.data.ownerUid == request.auth.uid)
        ||
        (request.auth == null && request.resource.data.ownerUid == '' && request.resource.data.ownerEmail == '')
      )
        && request.resource.data.ownerEmail is string
        && request.resource.data.keys().hasAll(['ownerUid','ownerEmail','nome','responsavel','uf','cidade','modalidade','categoria','contato','logo','atletas','plano','planoId','valorPlano','planoStatus','status','aprovacao','criadoEm'])
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','nome','responsavel','uf','cidade','modalidade','categoria','contato','logo','atletas','plano','planoId','valorPlano','planoStatus','status','aprovacao','criadoEm','pagamentoConfirmado'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.responsavel is string
        && request.resource.data.responsavel.size() >= 2
        && request.resource.data.responsavel.size() <= 100
        && request.resource.data.uf is string
        && request.resource.data.uf in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SE','TO']
        && request.resource.data.cidade is string
        && request.resource.data.cidade.size() >= 2
        && request.resource.data.cidade.size() <= 80
        && request.resource.data.modalidade is string
        && request.resource.data.modalidade.size() >= 2
        && request.resource.data.modalidade.size() <= 40
        && request.resource.data.categoria is string
        && request.resource.data.categoria in ['Iniciante','Intermediário','Avançado']
        && request.resource.data.contato is string
        && request.resource.data.contato.size() >= 5
        && request.resource.data.contato.size() <= 120
        && request.resource.data.get('logo', '') is string
        && request.resource.data.get('logo', '').size() <= 450000
        && request.resource.data.get('atletas', []) is list
        && request.resource.data.get('atletas', []).size() <= 30
        && request.resource.data.plano is string
        && request.resource.data.plano in ['Gratuito','Bronze','Prata','Ouro','Premium']
        && request.resource.data.planoId is string
        && request.resource.data.planoId in ['gratuito','bronze','prata','ouro','premium']
        && request.resource.data.valorPlano is number
        && (
          (request.resource.data.planoId == 'gratuito' && request.resource.data.valorPlano == 0) ||
          (request.resource.data.planoId == 'bronze' && request.resource.data.valorPlano == 9.9) ||
          (request.resource.data.planoId == 'prata' && request.resource.data.valorPlano == 19.9) ||
          (request.resource.data.planoId == 'ouro' && request.resource.data.valorPlano == 34.9) ||
          (request.resource.data.planoId == 'premium' && request.resource.data.valorPlano == 49.9)
        )
        && request.resource.data.planoStatus is string
        && request.resource.data.planoStatus in ['ativo','aguardando_pagamento']
        && request.resource.data.status == 'ativo'
        && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.criadoEm is string
        && request.resource.data.get('pagamentoConfirmado', false) is bool;

      allow read: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome','responsavel','uf','cidade','modalidade','categoria','contato','logo','atletas'
          ]));
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }
    // ============================================================
    // REDE SOCIAL
    // ============================================================
        match /publicacoes/{publicacaoId} {
      allow read: if resource.data.aprovado == true || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid','imagemUrl','legenda','tipo','aprovado','status','criadoEm'])
        && request.resource.data.keys().hasOnly([
          'ownerUid','ownerEmail','nome','texto','imagem',
          'imagemUrl','imagemPath','imagemMime','imagemTamanho',
          'legenda','tipo','aprovado','status','criadoEm'
        ])
        && request.resource.data.imagemUrl is string
        && request.resource.data.imagemUrl.size() <= 2000
        && request.resource.data.legenda is string
        && request.resource.data.legenda.size() <= 2200
        && request.resource.data.tipo == 'imagem'
        && request.resource.data.aprovado == true
        && request.resource.data.status == 'publicado'
        && request.resource.data.criadoEm is timestamp;

      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    match /comentarios_publicacoes/{comentarioId} {
      allow read: if resource.data.aprovado == true || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.publicacaoId is string
        && exists(/databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId))
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 3
        && request.resource.data.texto.size() <= 500
        && request.resource.data.aprovado == false
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly([
          'ownerUid','ownerEmail','publicacaoId','nome','texto',
          'parentCommentId','aprovado','status','criadoEm'
        ]);

      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && resource.data.aprovado == false);
    }

    match /curtidas_publicacoes/{publicacaoId}/usuarios/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && request.resource.data.uid == uid
        && request.resource.data.criadoEm is timestamp
        && exists(/databases/$(database)/documents/publicacoes/$(publicacaoId))
        && get(/databases/$(database)/documents/publicacoes/$(publicacaoId)).data.aprovado == true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    match /curtidas_perfis/{perfilId}/usuarios/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && request.resource.data.uid == uid
        && request.resource.data.criadoEm is timestamp
        && exists(/databases/$(database)/documents/atletas/$(perfilId));
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

        match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid','mediaUrl','legenda','tipo','criadoEm','expiraEm'])
        && request.resource.data.keys().hasOnly(['ownerUid','nome','mediaUrl','mediaPath','mediaType','legenda','tipo','criadoEm','expiraEm'])
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 2000
        && request.resource.data.legenda is string
        && request.resource.data.legenda.size() <= 2200
        && request.resource.data.tipo in ['image','video']
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.expiraEm is timestamp;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 1000
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['ownerUid','nome','videoUrl','videoPath','videoMime','videoTamanho','legenda','criadoEm']);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    match /denuncias/{denunciaId} {
      allow create: if request.auth != null
        && request.resource.data.reportadoPorUid == request.auth.uid
        && request.resource.data.alvoTipo in ['publicacao','comentario','perfil','equipe']
        && request.resource.data.alvoId is string
        && request.resource.data.alvoId.size() >= 1
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 3
        && request.resource.data.motivo.size() <= 300
        && request.resource.data.detalhes is string
        && request.resource.data.detalhes.size() <= 1000
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly([
          'alvoTipo','alvoId','motivo','detalhes',
          'reportadoPorUid','criadoEm','status'
        ]);
      allow read, update, delete: if isAdmin();
    }

    match /reivindicacoes_perfis/{claimId} {
      allow create: if request.auth != null
        && request.resource.data.solicitanteUid == request.auth.uid
        && request.resource.data.perfilId is string
        && request.resource.data.perfilId.size() >= 1
        && request.resource.data.perfilNome is string
        && request.resource.data.perfilNome.size() >= 2
        && request.resource.data.perfilNome.size() <= 100
        && request.resource.data.solicitanteEmail is string
        && request.resource.data.solicitanteNome is string
        && request.resource.data.solicitanteNome.size() <= 100
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly([
          'perfilId','perfilNome','solicitanteUid','solicitanteEmail',
          'solicitanteNome','status','criadoEm','atualizadoEm'
        ]);
      allow read: if isAdmin()
        || (request.auth != null && resource.data.solicitanteUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // SEGUIDORES / SEGUINDO
    // Cada documento de relacionamento usa o UID do usuário como ID.
    // Leitura pública para contagens e listagens; criação/exclusão somente
    // pelo usuário autenticado correspondente.
    // ============================================================

    match /seguidores/{perfilUid}/usuarios/{followerUid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == followerUid
        && followerUid != perfilUid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm']);
      allow delete: if request.auth != null
        && request.auth.uid == followerUid;
      allow update: if false;
    }

    match /seguindo/{perfilUid}/usuarios/{followedUid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == perfilUid
        && followedUid != perfilUid
        && request.resource.data.uid == followedUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm']);
      allow delete: if request.auth != null
        && request.auth.uid == perfilUid;
      allow update: if false;
    }

  }
}
