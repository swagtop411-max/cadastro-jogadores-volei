rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'swagtop411@gmail.com';
    }

    match /atletas/{atletaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /atletas/{atletaId}/privado/{documento} {
      allow read, write: if isAdmin();
    }

    match /apoiadores/{apoiadorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comentarios/{comentarioId} {
      // Visitantes só podem ler comentários já aprovados.
      // O administrador pode ler todos os comentários.
      allow read: if isAdmin() || resource.data.aprovado == true;

      // Visitantes podem enviar comentários, sempre começando como pendentes.
      allow create: if request.resource.data.keys().hasAll([
          'atletaId', 'nome', 'texto', 'aprovado', 'status', 'criadoEm'
        ])
        && request.resource.data.keys().hasOnly([
          'atletaId', 'nome', 'texto', 'aprovado', 'status', 'criadoEm'
        ])
        && request.resource.data.atletaId is string
        && request.resource.data.nome is string
        && request.resource.data.texto is string
        && request.resource.data.aprovado == false
        && request.resource.data.status == 'pendente'
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 80
        && request.resource.data.texto.size() >= 3
        && request.resource.data.texto.size() <= 500
        && request.resource.data.criadoEm is timestamp
        && exists(/databases/$(database)/documents/atletas/$(request.resource.data.atletaId));

      // Apenas o administrador pode aprovar, recusar ou excluir.
      allow update, delete: if isAdmin();
    }

    match /campeonatos/{campeonatoId} {
      // Campeonatos publicados são públicos. O administrador também pode
      // visualizar os campeonatos que ainda estão aguardando aprovação.
      allow read: if isAdmin() || resource.data.publicado == true;

      // Qualquer visitante pode enviar um campeonato, mas nunca pode publicá-lo
      // diretamente. A publicação inicial obrigatoriamente fica como false.
      allow create: if request.resource.data.publicado == false;

      // Somente o administrador pode aprovar, editar ou excluir campeonatos.
      allow update, delete: if isAdmin();
    }
  }
}