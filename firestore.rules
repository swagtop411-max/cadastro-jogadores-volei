rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == 'swagtop411@gmail.com'; }
    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.papel == 'usuario';
      allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == resource.data.uid && request.resource.data.papel == resource.data.papel;
      allow delete: if isAdmin();
    }
    match /atletas/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid);
    }
    match /atletas/{id}/privado/{sub} { allow read, write: if isAdmin(); }
    match /equipes/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid);
    }
    match /apoiadores/{id} { allow read: if true; allow write: if isAdmin(); }
    match /campeonatos/{id} { allow read: if isAdmin() || resource.data.publicado == true; allow create: if isAdmin() || request.resource.data.publicado == false; allow update, delete: if isAdmin(); }
    match /comentarios/{id} {
      allow read: if isAdmin() || resource.data.aprovado == true;
      allow create: if request.resource.data.atletaId is string && request.resource.data.nome is string && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 500 && request.resource.data.aprovado == false && request.resource.data.status == 'pendente' && request.resource.data.criadoEm is timestamp;
      allow update, delete: if isAdmin();
    }
    match /atletas_pendentes/{id} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail is string && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 100 && request.resource.data.nascimento is string && request.resource.data.cidade is string && request.resource.data.cidade.size() >= 2 && request.resource.data.cidade.size() <= 80 && request.resource.data.uf is string && request.resource.data.contato is string && request.resource.data.contato.size() >= 8 && request.resource.data.contato.size() <= 30 && request.resource.data.modalidades is list && request.resource.data.modalidades.size() >= 1 && request.resource.data.modalidades.size() <= 2 && request.resource.data.posicoes is list && request.resource.data.posicoes.size() >= 1 && request.resource.data.posicoes.size() <= 6 && request.resource.data.foto is string && request.resource.data.foto.size() <= 700000 && request.resource.data.status == 'ativo' && request.resource.data.aprovacao == 'pendente' && request.resource.data.planoId in ['gratuito','bronze','prata','ouro','premium'] && request.resource.data.valorPlano is number && request.resource.data.criadoEm is string;
      allow read: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid);
    }
    match /equipes_pendentes/{id} { allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail is string && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.status == 'ativo' && request.resource.data.aprovacao == 'pendente' && request.resource.data.planoId in ['gratuito','bronze','prata','ouro','premium'] && request.resource.data.valorPlano is number && request.resource.data.criadoEm is string; allow read: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid); allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid); }
    match /apoiadores_pendentes/{id} { allow create: if request.resource.data.aprovacao == 'pendente'; allow read, update, delete: if isAdmin(); }
    match /campeonatos_pendentes/{id} { allow create: if request.resource.data.aprovacao == 'pendente' && request.resource.data.publicado == false; allow read, update, delete: if isAdmin(); }
    match /publicacoes/{id} { allow read: if isAdmin() || resource.data.aprovado == true; allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail is string && request.resource.data.nome is string && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 1000 && request.resource.data.imagem is string && request.resource.data.aprovado == false && request.resource.data.status == 'pendente' && request.resource.data.criadoEm is timestamp; allow update, delete: if isAdmin(); }
    match /comentarios_publicacoes/{id} { allow read: if isAdmin() || resource.data.aprovado == true; allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail is string && request.resource.data.publicacaoId is string && request.resource.data.nome is string && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 500 && request.resource.data.aprovado == false && request.resource.data.status == 'pendente' && request.resource.data.criadoEm is timestamp; allow update, delete: if isAdmin(); }
    match /curtidas_perfis/{atletaId}/usuarios/{uid} { allow read: if true; allow create, delete: if request.auth != null && request.auth.uid == uid; allow update: if false; }
    match /curtidas_publicacoes/{postId}/usuarios/{uid} { allow read: if true; allow create, delete: if request.auth != null && request.auth.uid == uid; allow update: if false; }
    match /denuncias/{id} { allow create: if request.auth != null && request.resource.data.reportadoPorUid == request.auth.uid; allow read, update, delete: if isAdmin(); }
    match /site_stats/{id} { allow create: if request.resource.data.nome is string && request.resource.data.pagina is string && request.resource.data.criadoEm is timestamp; allow read, update, delete: if isAdmin(); }
    match /reivindicacoes_perfis/{id} {
      allow create: if request.auth != null && request.resource.data.solicitanteUid == request.auth.uid && request.resource.data.perfilId is string && request.resource.data.status == 'pendente';
      allow read: if isAdmin() || (request.auth != null && resource.data.solicitanteUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
