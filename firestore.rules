    match /denuncias/{denunciaId} {
      allow create: if signedIn() && request.resource.data.reportadoPorUid == request.auth.uid
        && request.resource.data.alvoTipo in ['publicacao','comentario','perfil','equipe']
        && request.resource.data.alvoId is string && request.resource.data.alvoId.size() >= 1
        && request.resource.data.motivo is string && request.resource.data.motivo.size() >= 3 && request.resource.data.motivo.size() <= 300
        && request.resource.data.detalhes is string && request.resource.data.detalhes.size() <= 1000
        && request.resource.data.status == 'pendente' && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['alvoTipo','alvoId','motivo','detalhes','reportadoPorUid','criadoEm','status']);
      allow read, update, delete: if isAdmin();
    }

    match /reivindicacoes_perfis/{claimId} {
      allow create: if signedIn() && request.resource.data.solicitanteUid == request.auth.uid && request.resource.data.solicitanteEmail == authEmail()
        && request.resource.data.perfilId is string && request.resource.data.perfilId.size() >= 1
        && request.resource.data.perfilNome is string && request.resource.data.perfilNome.size() >= 2 && request.resource.data.perfilNome.size() <= 100
        && request.resource.data.solicitanteNome is string && request.resource.data.solicitanteNome.size() <= 100
        && request.resource.data.status == 'pendente' && request.resource.data.criadoEm is timestamp && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['perfilId','perfilNome','solicitanteUid','solicitanteEmail','solicitanteNome','status','criadoEm','atualizadoEm']);
      allow read: if isAdmin() || (signedIn() && resource.data.solicitanteUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /seguidores/{perfilUid}/usuarios/{followerUid} {
      allow read: if true;
      allow create: if followerUid != perfilUid
        && exists(/databases/$(database)/documents/perfis/$(perfilUid))
        && !isBlocked(followerUid, perfilUid)
        && request.resource.data.uid == followerUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && (
          (isOwner(followerUid) && !profilePrivate(perfilUid)) ||
          (isOwner(perfilUid) && exists(/databases/$(database)/documents/solicitacoes_seguir/$(perfilUid)/usuarios/$(followerUid)))
        );
      allow delete: if isAdmin() || isOwner(followerUid) || isOwner(perfilUid);
      allow update: if false;
    }
    match /seguindo/{perfilUid}/usuarios/{followedUid} {
      allow read: if true;
      allow create: if followedUid != perfilUid
        && exists(/databases/$(database)/documents/perfis/$(followedUid))
        && !isBlocked(perfilUid, followedUid)
        && request.resource.data.uid == followedUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && (
          (isOwner(perfilUid) && !profilePrivate(followedUid)) ||
          (isOwner(followedUid) && exists(/databases/$(database)/documents/solicitacoes_seguir/$(followedUid)/usuarios/$(perfilUid)))
        );
      allow delete: if isAdmin() || isOwner(perfilUid) || isOwner(followedUid);
      allow update: if false;
    }
  }
}
