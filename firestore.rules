rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'swagtop411@gmail.com'
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function authEmail() { return request.auth.token.email; }
    function validUf(value) {
      return value is string && value in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
    }
    function validCategoria(value) {
      return value is string && value in ['Iniciante','Intermediário','Avançado'];
    }
    function validPlanoAtleta(plano, planoId, valor) {
      return plano in ['Gratuito','Bronze','Prata','Ouro','Premium']
        && planoId in ['gratuito','bronze','prata','ouro','premium']
        && valor is number
        && (
          (plano == 'Gratuito' && planoId == 'gratuito' && valor == 0) ||
          (plano == 'Bronze' && planoId == 'bronze' && valor == 9.9) ||
          (plano == 'Prata' && planoId == 'prata' && valor == 19.9) ||
          (plano == 'Ouro' && planoId == 'ouro' && valor == 34.9) ||
          (plano == 'Premium' && planoId == 'premium' && valor == 49.9)
        );
    }
    function validPlanoStatus(planoId, planoStatus) {
      return (planoId == 'gratuito' && planoStatus == 'ativo') ||
        (planoId != 'gratuito' && planoStatus == 'aguardando_pagamento');
    }
    function approvedSocialTarget(id) {
      return (
        exists(/databases/$(database)/documents/publicacoes/$(id)) &&
        get(/databases/$(database)/documents/publicacoes/$(id)).data.aprovado == true
      ) || (
        exists(/databases/$(database)/documents/videos/$(id)) &&
        get(/databases/$(database)/documents/videos/$(id)).data.aprovado == true
      );
    }
    function targetOwner(id) {
      return exists(/databases/$(database)/documents/publicacoes/$(id))
        ? get(/databases/$(database)/documents/publicacoes/$(id)).data.ownerUid
        : get(/databases/$(database)/documents/videos/$(id)).data.ownerUid;
    }
    function isBlocked(a,b) {
      return exists(/databases/$(database)/documents/bloqueios/$(a)/usuarios/$(b)) ||
        exists(/databases/$(database)/documents/bloqueios/$(b)/usuarios/$(a));
    }
    function profilePrivate(uid) {
      return exists(/databases/$(database)/documents/config_perfis/$(uid)) &&
        get(/databases/$(database)/documents/config_perfis/$(uid)).data.privado == true;
    }
    function followsProfile(uid) {
      return signedIn() && exists(/databases/$(database)/documents/seguidores/$(uid)/usuarios/$(request.auth.uid));
    }
    function canReadSocialOwner(uid, visibility) {
      return visibility == 'publico' || isAdmin() || isOwner(uid) || followsProfile(uid);
    }
    function socialTargetReadable(id) {
      return (
        exists(/databases/$(database)/documents/publicacoes/$(id)) &&
        get(/databases/$(database)/documents/publicacoes/$(id)).data.aprovado == true &&
        canReadSocialOwner(
          get(/databases/$(database)/documents/publicacoes/$(id)).data.ownerUid,
          get(/databases/$(database)/documents/publicacoes/$(id)).data.get('visibilidade','privado')
        )
      ) || (
        exists(/databases/$(database)/documents/videos/$(id)) &&
        get(/databases/$(database)/documents/videos/$(id)).data.aprovado == true &&
        canReadSocialOwner(
          get(/databases/$(database)/documents/videos/$(id)).data.ownerUid,
          get(/databases/$(database)/documents/videos/$(id)).data.get('visibilidade','privado')
        )
      );
    }
    function socialTargetAllowed(id) {
      return signedIn() && socialTargetReadable(id) && !isBlocked(request.auth.uid,targetOwner(id));
    }
    function storyReadable(id) {
      return exists(/databases/$(database)/documents/stories/$(id))
        && get(/databases/$(database)/documents/stories/$(id)).data.aprovado == true
        && canReadSocialOwner(
          get(/databases/$(database)/documents/stories/$(id)).data.ownerUid,
          get(/databases/$(database)/documents/stories/$(id)).data.get('visibilidade','privado')
        );
    }
    function conversationParticipant(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversas/$(cid))
        && request.auth.uid in get(/databases/$(database)/documents/conversas/$(cid)).data.participants;
    }
    function otherParticipant(list) { return list[0] == request.auth.uid ? list[1] : list[0]; }
    function conversationAllowed(cid) {
      return conversationParticipant(cid)
        && !isBlocked(request.auth.uid,otherParticipant(get(/databases/$(database)/documents/conversas/$(cid)).data.participants));
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.papel == 'usuario'
        && request.resource.data.email == authEmail()
        && request.resource.data.status == 'ativo'
        && request.resource.data.keys().hasOnly([
          'uid','nome','email','papel','status','criadoEm','atualizadoEm','nascimento','cidade','uf',
          'modalidade','modalidades','posicao','posicoes','categoria','time','contato','bio',
          'historicoCampeonatos','fotoUrl','fotoPath','capaUrl','capaPath','instagramUrl'
        ]);
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.papel == resource.data.papel
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('criadoEm', null) == resource.data.get('criadoEm', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome','nascimento','cidade','uf','modalidade','modalidades','posicao','posicoes','categoria',
          'time','contato','bio','historicoCampeonatos','fotoUrl','fotoPath','capaUrl','capaPath',
          'instagramUrl','atualizadoEm'
        ])
      );
      allow delete: if isAdmin();
    }

    match /access_logs/{eventId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == authEmail()
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 100
        && request.resource.data.tipo in ['cadastro','login','sessao']
        && request.resource.data.plataforma in ['web','app']
        && request.resource.data.dispositivo is string && request.resource.data.dispositivo.size() <= 30
        && request.resource.data.pagina is string && request.resource.data.pagina.size() <= 200
        && request.resource.data.fonte == 'cliente'
        && request.resource.data.confiavel == false
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.resource.data.criadoEm
        && request.resource.data.keys().hasOnly(['uid','email','nome','tipo','plataforma','dispositivo','pagina','fonte','confiavel','criadoEm','expiraEm']);
      allow update: if false;
    }

    match /site_stats/{eventId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.nome is string && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 60
        && request.resource.data.pagina is string && request.resource.data.pagina.size() <= 200
        && request.resource.data.visitante is string && request.resource.data.visitante.size() <= 120
        && request.resource.data.dispositivo in ['Celular','Tablet','Computador']
        && request.resource.data.origem is string && request.resource.data.origem.size() <= 50
        && request.resource.data.fonte == 'cliente'
        && request.resource.data.confiavel == false
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.resource.data.criadoEm
        && request.resource.data.keys().hasOnly(['nome','pagina','visitante','dispositivo','origem','fonte','confiavel','criadoEm','expiraEm']);
      allow update: if false;
    }

    match /solicitacoes_planos/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validPlanoAtleta(request.resource.data.plano,request.resource.data.planoId,request.resource.data.valor)
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','plano','planoId','valor','status','criadoEm','atualizadoEm']);
      allow delete: if isAdmin() || (isOwner(uid) && resource.data.status == 'pendente');
    }

    match /perfis/{uid} {
      allow read: if true;
      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','nome','cidade','uf','modalidade','posicao','categoria','time','bio','fotoUrl','fotoPath','capaUrl','capaPath','historicoCampeonatos','handle','instagramUrl'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 100
        && request.resource.data.cidade is string && request.resource.data.cidade.size() >= 2 && request.resource.data.cidade.size() <= 100
        && validUf(request.resource.data.uf) && validCategoria(request.resource.data.categoria)
        && request.resource.data.historicoCampeonatos is list && request.resource.data.historicoCampeonatos.size() <= 30
        && request.resource.data.get('handle','') is string && request.resource.data.get('handle','').size() <= 40
        && request.resource.data.get('instagramUrl','') is string && request.resource.data.get('instagramUrl','').size() <= 300;
      allow update: if (isOwner(uid) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid','nome','cidade','uf','modalidade','posicao','categoria','time','bio','fotoUrl','fotoPath','capaUrl','capaPath','historicoCampeonatos','handle','instagramUrl'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 100
        && request.resource.data.cidade is string && request.resource.data.cidade.size() >= 2 && request.resource.data.cidade.size() <= 100
        && validUf(request.resource.data.uf) && validCategoria(request.resource.data.categoria)
        && request.resource.data.historicoCampeonatos is list && request.resource.data.historicoCampeonatos.size() <= 30
        && request.resource.data.get('handle','') is string && request.resource.data.get('handle','').size() <= 40
        && request.resource.data.get('instagramUrl','') is string && request.resource.data.get('instagramUrl','').size() <= 300;
      allow delete: if isAdmin() || isOwner(uid);
    }
    match /perfis/{uid}/privado/{documento} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if isAdmin();
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && request.resource.data.handle is string && request.resource.data.handle.size() >= 3 && request.resource.data.handle.size() <= 40
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','handle','atualizadoEm'])
      );
      allow update: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.handle == handle
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','handle','atualizadoEm'])
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // V13_PERFIL_SOCIAL_BASICO
    // Toda conta pode possuir um perfil público mínimo antes de concluir os dados esportivos.
    // completo=false aceita somente campos públicos vazios/limitados; completo=true exige cidade, UF e categoria válidas.
    match /perfis/{uid} {
      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid','nome','cidade','uf','modalidade','posicao','categoria','time','bio',
          'fotoUrl','fotoPath','capaUrl','capaPath','historicoCampeonatos','handle','instagramUrl','completo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.get('cidade','') is string
        && request.resource.data.get('cidade','').size() <= 100
        && request.resource.data.get('uf','') is string
        && request.resource.data.get('uf','').size() <= 2
        && request.resource.data.get('modalidade','') is string
        && request.resource.data.get('modalidade','').size() <= 100
        && request.resource.data.get('posicao','') is string
        && request.resource.data.get('posicao','').size() <= 100
        && request.resource.data.get('categoria','') is string
        && request.resource.data.get('categoria','').size() <= 40
        && request.resource.data.get('time','') is string
        && request.resource.data.get('time','').size() <= 100
        && request.resource.data.get('bio','') is string
        && request.resource.data.get('bio','').size() <= 500
        && request.resource.data.get('fotoUrl','') is string
        && request.resource.data.get('fotoUrl','').size() <= 2000
        && request.resource.data.get('fotoPath','') is string
        && request.resource.data.get('fotoPath','').size() <= 1000
        && request.resource.data.get('capaUrl','') is string
        && request.resource.data.get('capaUrl','').size() <= 2000
        && request.resource.data.get('capaPath','') is string
        && request.resource.data.get('capaPath','').size() <= 1000
        && request.resource.data.get('historicoCampeonatos',[]) is list
        && request.resource.data.get('historicoCampeonatos',[]).size() <= 30
        && request.resource.data.get('handle','') is string
        && request.resource.data.get('handle','').size() <= 40
        && request.resource.data.get('instagramUrl','') is string
        && request.resource.data.get('instagramUrl','').size() <= 300
        && request.resource.data.get('completo',false) is bool
        && (
          request.resource.data.get('completo',false) == false
          || (
            request.resource.data.cidade.size() >= 2
            && validUf(request.resource.data.uf)
            && validCategoria(request.resource.data.categoria)
          )
        );

      allow update: if (isOwner(uid) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid','nome','cidade','uf','modalidade','posicao','categoria','time','bio',
          'fotoUrl','fotoPath','capaUrl','capaPath','historicoCampeonatos','handle','instagramUrl','completo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.get('cidade','') is string
        && request.resource.data.get('cidade','').size() <= 100
        && request.resource.data.get('uf','') is string
        && request.resource.data.get('uf','').size() <= 2
        && request.resource.data.get('modalidade','') is string
        && request.resource.data.get('modalidade','').size() <= 100
        && request.resource.data.get('posicao','') is string
        && request.resource.data.get('posicao','').size() <= 100
        && request.resource.data.get('categoria','') is string
        && request.resource.data.get('categoria','').size() <= 40
        && request.resource.data.get('time','') is string
        && request.resource.data.get('time','').size() <= 100
        && request.resource.data.get('bio','') is string
        && request.resource.data.get('bio','').size() <= 500
        && request.resource.data.get('fotoUrl','') is string
        && request.resource.data.get('fotoUrl','').size() <= 2000
        && request.resource.data.get('fotoPath','') is string
        && request.resource.data.get('fotoPath','').size() <= 1000
        && request.resource.data.get('capaUrl','') is string
        && request.resource.data.get('capaUrl','').size() <= 2000
        && request.resource.data.get('capaPath','') is string
        && request.resource.data.get('capaPath','').size() <= 1000
        && request.resource.data.get('historicoCampeonatos',[]) is list
        && request.resource.data.get('historicoCampeonatos',[]).size() <= 30
        && request.resource.data.get('handle','') is string
        && request.resource.data.get('handle','').size() <= 40
        && request.resource.data.get('instagramUrl','') is string
        && request.resource.data.get('instagramUrl','').size() <= 300
        && request.resource.data.get('completo',false) is bool
        && (
          (
            resource.data.get('completo',false) == false
            && request.resource.data.get('completo',false) == false
          )
          || (
            request.resource.data.get('completo',false) == true
            && request.resource.data.cidade.size() >= 2
            && validUf(request.resource.data.uf)
            && validCategoria(request.resource.data.categoria)
          )
        );
    }

    match /config_perfis/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.privado is bool
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','privado','atualizadoEm']);
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /bloqueios/{ownerUid}/usuarios/{blockedUid} {
      allow read: if isAdmin() || isOwner(ownerUid);
      allow create: if isOwner(ownerUid)
        && blockedUid != ownerUid
        && request.resource.data.uid == blockedUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && exists(/databases/$(database)/documents/perfis/$(blockedUid));
      allow delete: if isAdmin() || isOwner(ownerUid);
      allow update: if false;
    }

    match /solicitacoes_seguir/{targetUid}/usuarios/{requesterUid} {
      allow read: if isAdmin() || isOwner(targetUid) || isOwner(requesterUid);
      allow create: if isOwner(requesterUid)
        && requesterUid != targetUid
        && profilePrivate(targetUid)
        && !isBlocked(requesterUid,targetUid)
        && request.resource.data.uid == requesterUid
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','status','criadoEm'])
        && exists(/databases/$(database)/documents/perfis/$(targetUid));
      allow delete: if isAdmin() || isOwner(targetUid) || isOwner(requesterUid);
      allow update: if false;
    }

    match /destaques/{uid}/itens/{highlightId} {
      allow read: if canReadSocialOwner(uid, profilePrivate(uid) ? 'privado' : 'publico');
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 30
        && request.resource.data.capaUrl is string && request.resource.data.capaUrl.size() <= 2000
        && request.resource.data.storyIds is list && request.resource.data.storyIds.size() >= 1 && request.resource.data.storyIds.size() <= 20
        && request.resource.data.criadoEm is timestamp && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['ownerUid','titulo','capaUrl','storyIds','criadoEm','atualizadoEm']);
      allow update: if isOwner(uid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 30
        && request.resource.data.capaUrl is string && request.resource.data.capaUrl.size() <= 2000
        && request.resource.data.storyIds is list && request.resource.data.storyIds.size() >= 1 && request.resource.data.storyIds.size() <= 20
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['ownerUid','titulo','capaUrl','storyIds','criadoEm','atualizadoEm']);
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /atletas/{atletaId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome','cidade','uf','modalidades','posicoes','modalidade','posicao','categoria',
          'time','historicoEquipes','historicoCampeonatos','observacoes','instagramUrl','foto','ownerUid','atualizadoEm'
        ])
      );
    }
    match /atletas/{atletaId}/privado/{documento} { allow read, write: if isAdmin(); }

    match /apoiadores/{apoiadorId} { allow read: if true; allow write: if isAdmin(); }
    match /apoiadores_pendentes/{pedidoId} {
      allow create: if request.resource.data.keys().hasAll(['empresa','responsavel','contato','cidade','link','plano','planoId','valor','status','aprovacao','criadoEm'])
        && request.resource.data.keys().hasOnly(['empresa','responsavel','contato','cidade','link','imagem','plano','planoId','valor','status','aprovacao','criadoEm'])
        && request.resource.data.empresa is string && request.resource.data.empresa.size() >= 2 && request.resource.data.empresa.size() <= 100
        && request.resource.data.responsavel is string && request.resource.data.responsavel.size() >= 2 && request.resource.data.responsavel.size() <= 100
        && request.resource.data.contato is string && request.resource.data.contato.size() >= 5 && request.resource.data.contato.size() <= 120
        && request.resource.data.cidade is string && request.resource.data.cidade.size() >= 2 && request.resource.data.cidade.size() <= 80
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && (!request.resource.data.keys().hasAny(['imagem']) || (request.resource.data.imagem is string && request.resource.data.imagem.size() <= 700000))
        && request.resource.data.plano in ['Bronze','Prata','Ouro','Master']
        && request.resource.data.planoId in ['bronze','prata','ouro','master']
        && request.resource.data.valor is number
        && ((request.resource.data.plano == 'Bronze' && request.resource.data.valor == 50) || (request.resource.data.plano == 'Prata' && request.resource.data.valor == 100) || (request.resource.data.plano == 'Ouro' && request.resource.data.valor == 200) || (request.resource.data.plano == 'Master' && request.resource.data.valor == 350))
        && request.resource.data.status == 'aguardando_pagamento' && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.criadoEm is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /comentarios/{comentarioId} {
      allow read: if isAdmin() || resource.data.aprovado == true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == authEmail()
        && request.resource.data.keys().hasAll(['ownerUid','ownerEmail','atletaId','nome','texto','aprovado','status','criadoEm'])
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','atletaId','nome','texto','aprovado','status','criadoEm'])
        && request.resource.data.atletaId is string && request.resource.data.atletaId.size() >= 1
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 500
        && request.resource.data.aprovado == false && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && exists(/databases/$(database)/documents/atletas/$(request.resource.data.atletaId));
      allow update, delete: if isAdmin();
    }

