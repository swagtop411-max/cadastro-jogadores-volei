rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function authEmail() { return signedIn() ? request.auth.token.email : ''; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'swagtop411@gmail.com'
      );
    }
    function validUf(v) {
      return v is string && v in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
    }
    function validCategoria(v) { return v is string && v in ['Iniciante','Intermediário','Avançado']; }
    function approvedSocialTarget(id) {
      return (
        exists(/databases/$(database)/documents/publicacoes/$(id)) &&
        get(/databases/$(database)/documents/publicacoes/$(id)).data.aprovado == true
      ) || (
        exists(/databases/$(database)/documents/videos/$(id)) &&
        get(/databases/$(database)/documents/videos/$(id)).data.aprovado == true
      );
    }
    function targetOwner(id) {
      return exists(/databases/$(database)/documents/publicacoes/$(id))
        ? get(/databases/$(database)/documents/publicacoes/$(id)).data.ownerUid
        : get(/databases/$(database)/documents/videos/$(id)).data.ownerUid;
    }
    function isBlocked(a,b) {
      return exists(/databases/$(database)/documents/bloqueios/$(a)/usuarios/$(b)) ||
        exists(/databases/$(database)/documents/bloqueios/$(b)/usuarios/$(a));
    }
    function socialTargetAllowed(id) {
      return signedIn() && approvedSocialTarget(id) && !isBlocked(request.auth.uid,targetOwner(id));
    }
    function profilePrivate(uid) {
      return exists(/databases/$(database)/documents/config_perfis/$(uid)) &&
        get(/databases/$(database)/documents/config_perfis/$(uid)).data.privado == true;
    }
    function conversationParticipant(cid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/conversas/$(cid)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversas/$(cid)).data.participants;
    }
    function otherParticipant(list) { return list[0] == request.auth.uid ? list[1] : list[0]; }
    function conversationAllowed(cid) {
      return conversationParticipant(cid) &&
        !isBlocked(request.auth.uid,otherParticipant(get(/databases/$(database)/documents/conversas/$(cid)).data.participants));
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid && request.resource.data.email == authEmail();
      allow update: if isOwner(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    match /perfis/{uid} {
      allow read: if true;
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.data.uid == uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 100
        && request.resource.data.cidade is string
        && validUf(request.resource.data.uf)
        && validCategoria(request.resource.data.categoria)
        && request.resource.data.keys().hasOnly(['uid','nome','cidade','uf','modalidade','posicao','categoria','time','bio','fotoUrl','fotoPath','capaUrl','capaPath','historicoCampeonatos']);
      allow delete: if isAdmin() || isOwner(uid);
    }
    match /perfis/{uid}/privado/{documento} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    match /config_perfis/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.privado is bool
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','privado','atualizadoEm']);
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /bloqueios/{ownerUid}/usuarios/{blockedUid} {
      allow read: if isAdmin() || isOwner(ownerUid);
      allow create: if isOwner(ownerUid)
        && blockedUid != ownerUid
        && request.resource.data.uid == blockedUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && exists(/databases/$(database)/documents/perfis/$(blockedUid));
      allow delete: if isAdmin() || isOwner(ownerUid);
      allow update: if false;
    }

    match /solicitacoes_seguir/{targetUid}/usuarios/{requesterUid} {
      allow read: if isAdmin() || isOwner(targetUid) || isOwner(requesterUid);
      allow create: if isOwner(requesterUid)
        && requesterUid != targetUid
        && profilePrivate(targetUid)
        && !isBlocked(requesterUid,targetUid)
        && request.resource.data.uid == requesterUid
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','status','criadoEm'])
        && exists(/databases/$(database)/documents/perfis/$(targetUid));
      allow delete: if isAdmin() || isOwner(targetUid) || isOwner(requesterUid);
      allow update: if false;
    }

    match /destaques/{uid}/itens/{highlightId} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 1
        && request.resource.data.titulo.size() <= 30
        && request.resource.data.capaUrl is string
        && request.resource.data.capaUrl.size() <= 2000
        && request.resource.data.storyIds is list
        && request.resource.data.storyIds.size() >= 1
        && request.resource.data.storyIds.size() <= 20
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.keys().hasOnly(['ownerUid','titulo','capaUrl','storyIds','criadoEm','atualizadoEm']);
      allow update: if isOwner(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 30
        && request.resource.data.capaUrl is string
        && request.resource.data.storyIds is list
        && request.resource.data.storyIds.size() >= 1
        && request.resource.data.storyIds.size() <= 20
        && request.resource.data.atualizadoEm is timestamp;
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /atletas/{atletaId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','nascimento','cidade','uf','modalidades','posicoes','modalidade','posicao','categoria','time','historicoEquipes','historicoCampeonatos','observacoes','foto','ownerUid','ownerEmail','atualizadoEm']));
    }
    match /atletas/{atletaId}/privado/{documento} { allow read, write: if isAdmin(); }

    match /apoiadores/{id} { allow read: if true; allow write: if isAdmin(); }
    match /apoiadores_pendentes/{id} {
      allow create: if request.resource.data.status == 'aguardando_pagamento' && request.resource.data.aprovacao == 'pendente';
      allow read, update, delete: if isAdmin();
    }

    match /comentarios/{id} {
      allow read: if isAdmin() || resource.data.aprovado == true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == authEmail()
        && request.resource.data.aprovado == false
        && request.resource.data.status == 'pendente';
      allow update, delete: if isAdmin();
    }

    match /campeonatos/{id} { allow read: if isAdmin() || resource.data.publicado == true; allow write: if isAdmin(); }
    match /campeonatos_pendentes/{id} {
      allow create: if request.resource.data.publicado == false && request.resource.data.status == 'pendente' && request.resource.data.aprovacao == 'pendente';
      allow read, update, delete: if isAdmin();
    }

    match /atletas_pendentes/{id} {
      allow create: if (
          (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail == authEmail()) ||
          (!signedIn() && request.resource.data.ownerUid == '' && request.resource.data.ownerEmail == '')
        )
        && request.resource.data.status == 'ativo'
        && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.get('pagamentoConfirmado', false) == false
        && validUf(request.resource.data.uf)
        && validCategoria(request.resource.data.categoria);
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.get('pagamentoConfirmado', false) == resource.data.get('pagamentoConfirmado', false)
        && request.resource.data.plano == resource.data.plano
        && request.resource.data.planoId == resource.data.planoId
        && request.resource.data.valorPlano == resource.data.valorPlano
        && request.resource.data.planoStatus == resource.data.planoStatus
        && request.resource.data.aprovacao == resource.data.aprovacao);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /equipes/{equipeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','responsavel','uf','cidade','modalidade','categoria','logo','atletas']));
    }
    match /equipes/{equipeId}/privado/{documento} {
      allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/equipes/$(equipeId)).data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /equipes_pendentes/{id} {
      allow create: if (
          (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail == authEmail()) ||
          (!signedIn() && request.resource.data.ownerUid == '' && request.resource.data.ownerEmail == '')
        )
        && request.resource.data.status == 'ativo'
        && request.resource.data.aprovacao == 'pendente'
        && request.resource.data.get('pagamentoConfirmado', false) == false
        && validUf(request.resource.data.uf)
        && validCategoria(request.resource.data.categoria);
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.get('pagamentoConfirmado', false) == resource.data.get('pagamentoConfirmado', false)
        && request.resource.data.plano == resource.data.plano
        && request.resource.data.planoId == resource.data.planoId
        && request.resource.data.valorPlano == resource.data.valorPlano
        && request.resource.data.planoStatus == resource.data.planoStatus
        && request.resource.data.aprovacao == resource.data.aprovacao);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /publicacoes/{postId} {
      allow read: if resource.data.aprovado == true || isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('ownerEmail','') == authEmail()
        && request.resource.data.imagemUrl is string
        && request.resource.data.imagemUrl.size() <= 2000
        && request.resource.data.legenda is string
        && request.resource.data.legenda.size() <= 2200
        && request.resource.data.tipo in ['imagem','carrossel']
        && request.resource.data.aprovado == true
        && request.resource.data.status == 'publicado'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.get('imagemTamanho',0) is number
        && request.resource.data.get('imagemTamanho',0) <= 25 * 1024 * 1024
        && request.resource.data.get('midias',[]) is list
        && request.resource.data.get('midias',[]).size() <= 10
        && ((request.resource.data.tipo == 'imagem' && request.resource.data.get('midias',[]).size() == 0) || (request.resource.data.tipo == 'carrossel' && request.resource.data.get('midias',[]).size() >= 2))
        && request.resource.data.get('hashtags',[]) is list
        && request.resource.data.get('hashtags',[]).size() <= 30
        && request.resource.data.get('mencoes',[]) is list
        && request.resource.data.get('mencoes',[]).size() <= 20
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','nome','texto','imagem','imagemUrl','imagemPath','imagemMime','imagemTamanho','legenda','tipo','midias','hashtags','mencoes','armazenamento','aprovado','status','criadoEm']);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legenda','texto','hashtags','mencoes']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /videos/{videoId} {
      allow read: if isAdmin() || resource.data.aprovado == true || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 2000
        && request.resource.data.get('videoTamanho',0) is number
        && request.resource.data.get('videoTamanho',0) <= 45 * 1024 * 1024
        && request.resource.data.get('legenda','') is string
        && request.resource.data.get('legenda','').size() <= 2200
        && request.resource.data.get('hashtags',[]) is list
        && request.resource.data.get('hashtags',[]).size() <= 30
        && request.resource.data.get('mencoes',[]) is list
        && request.resource.data.get('mencoes',[]).size() <= 20
        && request.resource.data.aprovado == true
        && request.resource.data.status == 'publicado'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['ownerUid','nome','videoUrl','videoPath','videoMime','videoTamanho','legenda','hashtags','mencoes','aprovado','status','criadoEm']);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legenda','hashtags','mencoes']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /comentarios_publicacoes/{id} {
      allow read: if resource.data.aprovado == true || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == authEmail()
        && socialTargetAllowed(request.resource.data.publicacaoId)
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 1
        && request.resource.data.texto.size() <= 500
        && request.resource.data.aprovado == true
        && request.resource.data.status == 'publicado';
      allow update: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /curtidas_publicacoes/{postId}/usuarios/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && socialTargetAllowed(postId)
        && request.resource.data.uid == uid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm']);
      allow delete: if isOwner(uid);
      allow update: if false;
    }
    match /curtidas_perfis/{perfilId}/usuarios/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && !isBlocked(uid,perfilId) && request.resource.data.uid == uid && request.resource.data.criadoEm is timestamp;
      allow delete: if isOwner(uid);
      allow update: if false;
    }
    match /salvos/{uid}/publicacoes/{postId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && socialTargetAllowed(postId)
        && request.resource.data.postId == postId
        && request.resource.data.kind is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['postId','kind','createdAt']);
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /stories/{storyId} {
      allow read: if isAdmin() || resource.data.aprovado == true || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 2000
        && request.resource.data.legenda is string
        && request.resource.data.legenda.size() <= 2200
        && request.resource.data.tipo in ['image','video']
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.resource.data.criadoEm
        && request.resource.data.aprovado == true
        && request.resource.data.status == 'publicado'
        && request.resource.data.keys().hasOnly(['ownerUid','nome','mediaUrl','mediaPath','mediaType','legenda','tipo','criadoEm','expiraEm','aprovado','status']);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legenda']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /story_views/{storyId}/usuarios/{viewerUid} {
      allow read: if isAdmin() || isOwner(viewerUid) || (signedIn()
        && exists(/databases/$(database)/documents/stories/$(storyId))
        && get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid == request.auth.uid);
      allow create, update: if isOwner(viewerUid)
        && request.resource.data.viewerUid == viewerUid
        && request.resource.data.viewedAt is timestamp
        && request.resource.data.keys().hasOnly(['viewerUid','viewedAt']);
      allow delete: if isAdmin() || isOwner(viewerUid);
    }

    match /conversas/{conversationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && !isBlocked(request.auth.uid,otherParticipant(request.resource.data.participants))
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 500
        && request.resource.data.lastSenderUid is string
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastReadBy is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['participants','lastMessage','lastSenderUid','lastMessageAt','lastReadBy','createdAt']);
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid in resource.data.participants
        && !isBlocked(request.auth.uid,otherParticipant(resource.data.participants))
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['participants','lastMessage','lastSenderUid','lastMessageAt','lastReadBy','createdAt'])
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadBy']) && request.auth.uid in request.resource.data.lastReadBy) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderUid','lastMessageAt','lastReadBy'])
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() >= 1
            && request.resource.data.lastMessage.size() <= 500
            && request.resource.data.lastMessageAt is timestamp
            && request.resource.data.lastReadBy == [request.auth.uid])
        ));
      allow delete: if isAdmin();

      match /mensagens/{messageId} {
        allow read: if isAdmin() || conversationParticipant(conversationId);
        allow create: if conversationAllowed(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type in ['text','image','video']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.get('mediaUrl','') is string
          && request.resource.data.get('mediaUrl','').size() <= 2000
          && request.resource.data.get('mediaPath','') is string
          && request.resource.data.get('mediaPath','').size() <= 1000
          && request.resource.data.get('mediaMime','') is string
          && request.resource.data.get('mediaMime','').size() <= 100
          && request.resource.data.get('mediaSize',0) is number
          && request.resource.data.get('mediaSize',0) <= 45 * 1024 * 1024
          && ((request.resource.data.type == 'text' && request.resource.data.text.size() >= 1) || (request.resource.data.type in ['image','video'] && request.resource.data.get('mediaUrl','').size() >= 8))
          && request.resource.data.keys().hasOnly(['senderUid','text','type','mediaUrl','mediaPath','mediaMime','mediaSize','createdAt']);
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.senderUid == request.auth.uid);
      }
    }

    match /notificacoes/{targetUid}/itens/{notificationId} {
      allow read: if isAdmin() || isOwner(targetUid);
      allow create: if signedIn()
        && targetUid != request.auth.uid
        && !isBlocked(request.auth.uid,targetUid)
        && request.resource.data.targetUid == targetUid
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorNome is string
        && request.resource.data.actorFoto is string
        && request.resource.data.type in ['like','comment','follow','message','mention']
        && request.resource.data.sourceId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.lida == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['targetUid','actorUid','actorNome','actorFoto','type','sourceId','text','lida','createdAt']);
      allow update: if isAdmin() || (isOwner(targetUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']) && request.resource.data.lida is bool);
      allow delete: if isAdmin() || isOwner(targetUid);
    }

    match /denuncias/{id} {
      allow create: if signedIn() && request.resource.data.reportadoPorUid == request.auth.uid && request.resource.data.status == 'pendente';
      allow read, update, delete: if isAdmin();
    }
    match /reivindicacoes_perfis/{id} {
      allow create: if signedIn() && request.resource.data.solicitanteUid == request.auth.uid && request.resource.data.solicitanteEmail == authEmail() && request.resource.data.status == 'pendente';
      allow read: if isAdmin() || (signedIn() && resource.data.solicitanteUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /seguidores/{perfilUid}/usuarios/{followerUid} {
      allow read: if true;
      allow create: if followerUid != perfilUid
        && exists(/databases/$(database)/documents/perfis/$(perfilUid))
        && !isBlocked(followerUid,perfilUid)
        && request.resource.data.uid == followerUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && (
          (isOwner(followerUid) && !profilePrivate(perfilUid)) ||
          (isOwner(perfilUid) && exists(/databases/$(database)/documents/solicitacoes_seguir/$(perfilUid)/usuarios/$(followerUid)))
        );
      allow delete: if isAdmin() || isOwner(followerUid) || isOwner(perfilUid);
      allow update: if false;
    }
    match /seguindo/{perfilUid}/usuarios/{followedUid} {
      allow read: if true;
      allow create: if followedUid != perfilUid
        && exists(/databases/$(database)/documents/perfis/$(followedUid))
        && !isBlocked(perfilUid,followedUid)
        && request.resource.data.uid == followedUid
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.keys().hasOnly(['uid','criadoEm'])
        && (
          (isOwner(perfilUid) && !profilePrivate(followedUid)) ||
          (isOwner(followedUid) && exists(/databases/$(database)/documents/solicitacoes_seguir/$(followedUid)/usuarios/$(perfilUid)))
        );
      allow delete: if isAdmin() || isOwner(perfilUid) || isOwner(followedUid);
      allow update: if false;
    }
  }
}
