rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /atletas/{atletaId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'swagtop411@gmail.com';
    }

    match /atletas/{atletaId}/privado/{documento} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'swagtop411@gmail.com';
    }

    match /apoiadores/{apoiadorId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'swagtop411@gmail.com';
    }
  }
}