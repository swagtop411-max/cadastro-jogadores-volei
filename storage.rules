rules_version = '2';

service firebase.storage {
  function isAdmin() {
    return request.auth != null
      && (
        request.auth.token.admin == true
        || request.auth.token.email == 'swagtop411@gmail.com'
      );
  }

  function isImage() {
    return request.resource != null
      && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
  }

  function isVideo() {
    return request.resource != null
      && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
  }

  match /b/{bucket}/o {
    match /usuarios/{uid}/perfil/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isImage()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
    }

    match /usuarios/{uid}/capa/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isImage()
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
    }

    match /usuarios/{uid}/publicacoes/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (isImage() && request.resource.size <= 10 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 45 * 1024 * 1024)
        );
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
    }

    match /usuarios/{uid}/videos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isVideo()
        && request.resource.size <= 45 * 1024 * 1024;
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
    }

    match /usuarios/{uid}/stories/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (isImage() && request.resource.size <= 10 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 45 * 1024 * 1024)
        );
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
    }
  }
}
