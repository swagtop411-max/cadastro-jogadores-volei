rules_version = '2';

service firebase.storage {
  function isAdmin() {
    return request.auth != null
      && (
        request.auth.token.admin == true
        || request.auth.token.email == 'swagtop411@gmail.com'
      );
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  function isImage() {
    return request.resource != null
      && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
  }

  function isVideo() {
    return request.resource != null
      && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
  }

  match /b/{bucket}/o {
    // Foto de perfil: pública, mas somente o dono pode criar um novo arquivo.
    // update é bloqueado para evitar substituição silenciosa de objetos existentes.
    match /usuarios/{uid}/perfil/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isImage()
        && request.resource.size <= 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /usuarios/{uid}/capa/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isImage()
        && request.resource.size <= 8 * 1024 * 1024;
      allow update: if false;
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /usuarios/{uid}/publicacoes/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isImage()
        && request.resource.size <= 10 * 1024 * 1024;
      allow update: if false;
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /usuarios/{uid}/videos/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isVideo()
        && request.resource.size <= 45 * 1024 * 1024;
      allow update: if false;
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /usuarios/{uid}/stories/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid)
        && (
          (isImage() && request.resource.size <= 10 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 45 * 1024 * 1024)
        );
      allow update: if false;
      allow delete: if isAdmin() || isOwner(uid);
    }
  }
}
