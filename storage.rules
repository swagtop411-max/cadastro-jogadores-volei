rules_version = '2';

service firebase.storage {
  function isAdmin() {
    return request.auth != null && request.auth.token.email == 'swagtop411@gmail.com';
  }

  match /b/{bucket}/o {
    match /usuarios/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|video/(mp4|webm|quicktime)'));
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
