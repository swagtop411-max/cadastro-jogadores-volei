{
  "expo": {
    "name": "Banco de Atletas",
    "slug": "cadastro-de-atletas",
    "scheme": "cadastrodeatletas",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/branding/app-icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "br.com.cadastrodeatletas.app",
      "versionCode": 2,
      "icon": "./assets/branding/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-icon-foreground.png",
        "backgroundColor": "#031525"
      }
    },
    "ios": {
      "bundleIdentifier": "br.com.cadastrodeatletas.app",
      "buildNumber": "2"
    },
    "web": {
      "favicon": "./assets/branding/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031525",
          "image": "./assets/branding/splash-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#031525",
            "image": "./assets/branding/splash-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Banco de Atletas acesse suas fotos e vídeos para criar publicações e atualizar seu perfil.",
          "cameraPermission": "Permitir que o Banco de Atletas use a câmera para criar publicações e atualizar seu perfil.",
          "microphonePermission": "Permitir que o Banco de Atletas use o microfone ao gravar vídeos pela câmera."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e36cd3b7-4cac-455c-9250-99ae8019aace"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
