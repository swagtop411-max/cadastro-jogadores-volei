{
  "expo": {
    "name": "Banco de Atletas",
    "slug": "cadastro-de-atletas",
    "scheme": "cadastrodeatletas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/branding/app-icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "br.com.cadastrodeatletas.app",
      "versionCode": 4,
      "icon": "./assets/branding/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-icon.png",
        "backgroundColor": "#031525"
      }
    },
    "ios": {
      "bundleIdentifier": "br.com.cadastrodeatletas.app",
      "buildNumber": "4"
    },
    "web": {
      "favicon": "./assets/branding/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031525",
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#031525",
            "image": "./assets/branding/app-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Banco de Atletas acesse suas fotos e vídeos para criar publicações, Stories, mensagens e atualizar seu perfil.",
          "cameraPermission": "Permitir que o Banco de Atletas use a câmera para criar publicações, Stories e atualizar seu perfil.",
          "microphonePermission": "Permitir que o Banco de Atletas use o microfone ao gravar vídeos pela câmera."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "legal": {
        "privacyUrl": "https://cadastrodeatletas.com.br/politica-privacidade.html",
        "termsUrl": "https://cadastrodeatletas.com.br/termos-de-uso.html",
        "accountDeletionUrl": "https://cadastrodeatletas.com.br/excluir-conta.html"
      },
      "eas": {
        "projectId": "e36cd3b7-4cac-455c-9250-99ae8019aace"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
